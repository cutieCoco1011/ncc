# Provider selection. The default test and demo path uses mock providers.
NCC_LLM_PROVIDER=mock
NCC_TAG_PROVIDER=mock
NCC_IMAGE_PROVIDER=mock

# Local project storage root.
NCC_PROJECTS_DIR=ncc-projects

# Real providers are optional and never required for the default test suite.
# Set only in a local .env file; do not commit real values.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# NOVELAI_API_TOKEN=
# NOVELAI_IMAGE_ENDPOINT=https://image.novelai.net/ai/generate-image
# NOVELAI_IMAGE_MODEL=nai-diffusion-3
# NOVELAI_TIMEOUT_SECONDS=180
