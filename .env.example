# Provider selection. The default test and demo path uses mock providers.
NCC_LLM_PROVIDER=mock
NCC_TAG_PROVIDER=mock
NCC_IMAGE_PROVIDER=mock
# Keep model-assisted tag suggestions local/off by default. Set to external only
# when you intentionally want a configured tag provider to spend API tokens for
# candidate suggestions before the local compiler filters them.
NCC_TAG_SUGGESTION_MODE=local

# Local project storage root.
NCC_PROJECTS_DIR=ncc-projects

# Real providers are optional and never required for the default test suite.
# Set only in a local .env file; do not commit real values.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# Model-assisted tag providers are intended for tag-candidate extraction only;
# final prompts must still pass through the local Danbooru compiler before any
# image generation.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_TIMEOUT_SECONDS=30
# MIMO_API_KEY=
# MIMO_MODEL=mimo-tag-candidate
# MIMO_BASE_URL=
# MIMO_TIMEOUT_SECONDS=30
# NOVELAI_API_TOKEN=
# NOVELAI_IMAGE_ENDPOINT=https://image.novelai.net/ai/generate-image
# NOVELAI_IMAGE_MODEL=nai-diffusion-3
# NOVELAI_TIMEOUT_SECONDS=180
